# Copy to .env.local. Only public, non-secret values go here (they reach the browser).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where the Python backend runs. Not NEXT_PUBLIC_: it stays on the server, the browser never sees it.
BACKEND_URL=http://localhost:8000
# true = onboarding uses a sample resume instead of calling the backend
NEXT_PUBLIC_USE_MOCK=true