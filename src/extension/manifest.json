{
  "manifest_version": 3,
  "name": "Job Assist",
  "version": "0.2.0",
  "description": "Fills your approved Job Assist applications on Greenhouse. It never submits: you do.",
  "key": "",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "externally_connectable": { "matches": [
  "http://localhost:3000/*", "http://127.0.0.1:3000/*",
  "https://localhost/*", "https://job-assistant.localhost/*"
  ]},
  "content_scripts": [
    {
      "matches": ["https://job-boards.greenhouse.io/*", "https://boards.greenhouse.io/*"],
      "js": ["match.js", "fill.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
